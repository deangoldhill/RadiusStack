# Source IP is FreeRADIUS's packet transport source, not a NAS-supplied AVP.
# One SQL expansion returns N for a known but unrouted NAS, X for ambiguous/unknown
# sources. Empty expansion (including SQL error) is NEVER a local-route fallback.
# The known-user profile route has priority; otherwise the NAS route applies.
native_proxy_select {
    update control {
        &Tmp-String-7 := "%{sql:SELECT CASE WHEN (SELECT COUNT(*) FROM nas WHERE nasname = '%{Packet-Src-IP-Address}') != 1 THEN 'X' ELSE COALESCE((SELECT CASE WHEN d.proxy_traffic IN ('both', '%{control:Tmp-String-6}') THEN CONCAT(CASE WHEN r.mode = 'proxy-only' THEN 'P' WHEN r.validate_response = 1 THEN 'V' ELSE 'D' END, ':', r.destination_id) ELSE 'N' END FROM nas n JOIN radcheck c ON c.username = UNHEX('%{hex:&User-Name}') AND c.tenant_id <=> n.tenant_id JOIN radusergroup g ON g.username = c.username AND g.tenant_id <=> n.tenant_id JOIN profile_downstream_routes r ON r.profile_name = g.groupname AND r.tenant_id <=> n.tenant_id JOIN downstream_radius_destinations d ON d.id = r.destination_id AND d.tenant_id <=> n.tenant_id WHERE n.nasname = '%{Packet-Src-IP-Address}' ORDER BY g.priority, g.id LIMIT 1), (SELECT CASE WHEN d.proxy_traffic IN ('both', '%{control:Tmp-String-6}') THEN CONCAT(CASE WHEN n.downstream_mode = 'proxy-only' THEN 'P' WHEN n.downstream_validate_response = 1 THEN 'V' ELSE 'D' END, ':', n.downstream_destination_id) ELSE 'N' END FROM nas n JOIN downstream_radius_destinations d ON d.id = n.downstream_destination_id AND d.tenant_id <=> n.tenant_id WHERE n.nasname = '%{Packet-Src-IP-Address}' LIMIT 1), 'N') END}"
    }
}

native_proxy_select_auth {
    update control { &Tmp-String-6 := "auth" }
    native_proxy_select
}

native_proxy_select_acct {
    update control { &Tmp-String-6 := "accounting" }
    native_proxy_select
}

native_proxy_auth {
    native_proxy_select_auth
    if (fail || reject) {
        reject
    }
    if (!&control:Tmp-String-7 || &control:Tmp-String-7 == "" || &control:Tmp-String-7 == "X") {
        reject
    }
    if (&control:Tmp-String-7 == "N") {
        noop
    }
    if (&control:Tmp-String-7 =~ /^P:([0-9]+)$/) {
        update control { &Proxy-To-Realm := "downstream_%{1}" }
        return
    }
    if (&control:Tmp-String-7 =~ /^D:([0-9]+)$/) {
        update control { &Replicate-To-Realm := "downstream_%{1}" }
        replicate
    }
    if (&control:Tmp-String-7 =~ /^V:([0-9]+)$/) {
        update request { &Tmp-String-0 := "%{Packet-Src-IP-Address}" }
        native_downstream_validate
        if (reject || fail) {
            reject
        }
    }
    if (&control:Tmp-String-7 !~ /^(N|D:[0-9]+|V:[0-9]+)$/) {
        reject
    }
}

native_proxy_acct {
    native_proxy_select_acct
    if (fail || reject) {
        reject
    }
    if (!&control:Tmp-String-7 || &control:Tmp-String-7 == "" || &control:Tmp-String-7 == "X") {
        reject
    }
    if (&control:Tmp-String-7 == "N") {
        noop
    }
    if (&control:Tmp-String-7 =~ /^P:([0-9]+)$/) {
        # Require downstream accounting ACK before recording local plan usage.
        update request { &Tmp-String-0 := "%{Packet-Src-IP-Address}" }
        native_downstream_validate_acct
        if (reject || fail) {
            reject
        }
    }
    if (&control:Tmp-String-7 =~ /^D:([0-9]+)$/) {
        update control { &Replicate-To-Realm := "downstream_%{1}" }
        replicate
    }
    if (&control:Tmp-String-7 =~ /^V:([0-9]+)$/) {
        update request { &Tmp-String-0 := "%{Packet-Src-IP-Address}" }
        native_downstream_validate_acct
        if (reject || fail) {
            reject
        }
    }
    if (&control:Tmp-String-7 !~ /^(N|P:[0-9]+|D:[0-9]+|V:[0-9]+)$/) {
        reject
    }
}
