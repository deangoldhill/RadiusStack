# RadiusStack settings (KEY=value). Lines beginning with # are explanations, not settings.
# Keep this file private: it contains passwords and encryption secrets.
# If you change a setting, check how to apply it before restarting services.

######Usernames, passphrases and passwords###
# Password for the database administrator (root).
DB_ROOT_PASSWORD=ChangeMePlease123

# Username that RadiusStack uses to connect to its database. 
DB_USER=radiusapp1234

# Password for DB_USER. Keep it private; changing it only here may stop RadiusStack from connecting to the existing database.
DB_PASSWORD=ChangeMePlease123

# Private signing secret for website/API login tokens. Make it long and complex
JWT_SECRET=ChangeMeToSomethingVeryLong
######Usernames, passphrases and passwords###


######RadSec (encrypted Radius) conifg###
# Private key used by the API to protect stored RadSec certificate/key passphrases. 
#Must be a 32bit passphrase. Use 'openssl rand -base64 32' to generate a random passphrase
RADSEC_PASSPHRASE_ENCRYPTION_KEY=dFAC9z3Q3jjSUHlN3IUtcNHXj3V8aRgPf/dz+uLFvwY=

RADSEC_PORT=2083

# Optional RadSec server identity settings
# These describe the name/address in the RadSec server's TLS certificate.
# In most cases, these do not need to be modified
RADSEC_SERVER_DNS=radiusstack-radsec
RADSEC_SERVER_IP=127.0.0.1
######RadSec (encrypted Radius) conifg###


######HA config### don't modify if not using HA. Uncomment and set values when using HA.
# High availability: true only when running a coordinated primary/secondary pair; false for a single installation.
HA_ENABLED=false
# This installation's role in a high-availability pair (primary or secondary). Leave as primary for a single installation.
#HA_ROLE=primary
# DB record offset to avoid conflict
#HA_DB_OFFSET=1   # Set to 2 on the secondary node
# IP of other member when using HA. 
# HA_PEER_IP: other server's IP for a high-availability pair; leave unset for one server
# Private token used for communication between high-availability peers. Keep it private; both peers must use the same token when HA is enabled.
#HA_API_TOKEN=ChangeMeToSomethingVeryLong
######HA config### don't modify if not using HA.



######General settings###
# Time zone used by the containers for local dates and times (for example, Europe/London).
TIMEZONE=Europe/London

# Name shown for RadiusStack accounts in an authenticator app when setting up two-factor login (TOTP).
TOTP_ISSUER=RadiusStack
# number of one-time-code digits in that suffix (default 6).
RADIUS_TOTP_SUFFIX_DIGITS=6
######General settings###

######Network Ports for containers###
 RADIUS_AUTH_PORT=1812
 RADIUS_ACCT_PORT=1813
 DB_PORT=3306
 API_PORT=3000
 WEB_UI_PORT=80
 PHPMYADMIN_PORT=8080
######Network Ports for containers###