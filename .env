# RadiusStack settings (KEY=value). Lines beginning with # are explanations, not settings.
# These defaults are PUBLIC and shared by everyone who downloads this release.
# Change the passwords and keys for any installation that must be secure.
# Keep the configured .env private; preserve its values across upgrades.

###### Usernames, passphrases and passwords ######
# Database administrator password. PUBLIC DEFAULT: change for production.
DB_ROOT_PASSWORD=fd66045bebffceaf773f9042ab65d4e98dee2d63fc280fd9
# Username RadiusStack uses to connect to MariaDB.
DB_USER=radius
# Database application password. PUBLIC DEFAULT: change for production.
DB_PASSWORD=b0a448d56417fe457ebdcedeb4260b46d4ab61bbabc32cf6
# Private signing secret for website/API login tokens. PUBLIC DEFAULT: change it.
JWT_SECRET=1b5e597aed249bf68e7281f25baf2c786404ebe6cdc634aed1da2fe434cf34653d682a10ae30067f9e7c42f6ef9df415

###### RadSec (encrypted RADIUS) configuration ######
# Base64 encoding of 32 bytes for protecting stored RadSec passphrases.
# PUBLIC DEFAULT: change before storing production passphrases, then keep it stable.
RADSEC_PASSPHRASE_ENCRYPTION_KEY=ihiiXZ5J6Juahqjil86K4MMN59vw7/6Zc/NQOMNHNEE=
RADSEC_PORT=2083
# Replace with the hostname RadSec clients actually use to validate the TLS certificate.
RADSEC_SERVER_DNS=radius-stack.example.com
# Optional certificate IP SAN; hostname-based RadSec clients do not need it.
#RADSEC_SERVER_IP=127.0.0.1

###### High availability (leave disabled for a single server) ######
HA_ENABLED=false
#HA_ROLE=primary
#HA_DB_OFFSET=1
#HA_PEER_IP=
#HA_API_TOKEN=

###### General settings ######
TIMEZONE=Europe/London
TOTP_ISSUER=RadiusStack
RADIUS_TOTP_ENABLED=false
RADIUS_TOTP_SUFFIX_DIGITS=6

###### Network ports published by Docker ######
# Change ports here if another service is already using one of them.
RADIUS_AUTH_PORT=1812
RADIUS_ACCT_PORT=1813
DB_PORT=3306
API_PORT=3000
WEB_UI_PORT=80
PHPMYADMIN_PORT=8080
