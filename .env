# === RADIUS FULLSTACK CONFIGURATION ===
# Change the ports below to bind the containers to different host ports.

# Nginx Web Frontend Port
WEB_UI_PORT=80

# Backend Node.js API Port
API_PORT=3000

# FreeRADIUS Ports
RADIUS_AUTH_PORT=1812
RADIUS_ACCT_PORT=1813

# Database Export Port (Change if you want to connect externally, e.g., using DataGrip/DBeaver)
DB_PORT=3306

# phpMyAdmin Port
PHPMYADMIN_PORT=8080

# Number of digits at the end of the password used for the OTP
RADIUS_TOTP_SUFFIX_DIGITS=6
TOTP_ISSUER=RadiusStack


# === DATABASE CONFIGURATION ===
DB_ROOT_PASSWORD=radiusdbrootpass
DB_USER=radius
DB_PASSWORD=radiusdbpass

# === SECURITY CONFIGURATION ===
# A long, random string used to securely sign JWT tokens for TOTP and sessions
JWT_SECRET=dfgd6zI&aS8C3XDTMp&ZFyqAso0FzBz!W^0c8gs$4q0^#m3oT@!p1d@#bb93ju1N3443fdgfdgdf

# --- High Availability Settings ---
HA_ENABLED=true
HA_ROLE=primary
HA_DB_OFFSET=1   # Set to 2 on the secondary node
HA_PEER_IP=192.168.4.30
HA_API_TOKEN=6zI&aS8C3XDTMp&ZFyqAso0FzBz!W^0c8gs$4q0^#m3oT@!p1d@#bb93ju1N

# === TIMEZONE ===
TIMEZONE=Europe/London
